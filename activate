#!/usr/bin/env nix-shell
#! nix-shell -i bash -p perl
set -euo pipefail

CONFIG_PATH="$(realpath "$1")"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

NIXPKGS="${2:-}"
if [ -z "$NIXPKGS" ] && [ -f "$SCRIPT_DIR/flake.lock" ]; then
  NIXPKGS=$(nix-instantiate --eval -E \
    "(builtins.fromJSON (builtins.readFile $SCRIPT_DIR/flake.lock)).nodes.nixpkgs.locked.rev" \
    | tr -d '"')
fi
: "${NIXPKGS:=nixos-unstable}"

# preflight
[ "$(uname -s)" = "Linux" ]    || { echo "Requires Linux."; exit 1; }
[ -d /run/systemd/system ]     || { echo "Requires systemd."; exit 1; }
[ ! -f /etc/NIXOS ]            || { echo "Already NixOS."; exit 1; }
command -v nix-build >/dev/null || { echo "Requires Nix."; exit 1; }
sudo -n true 2>/dev/null        || { echo "Requires passwordless sudo."; exit 1; }

if [ -z "${CI:-}" ]; then
  read -rp "This will activate NixOS on top of your running system. Are you sure? [y/N] " confirm
  [[ "$confirm" == [yY] ]] || exit 1
fi

ROOT_DEV=$(findmnt -n -o SOURCE /)
ROOT_FSTYPE=$(findmnt -n -o FSTYPE /)
NIX_DEV=$(findmnt -n -o SOURCE /nix 2>/dev/null || true)
NIX_FSTYPE=$(findmnt -n -o FSTYPE /nix 2>/dev/null || true)
DNS=$(resolvectl status 2>/dev/null | sed -n 's/.*DNS Servers:[[:space:]]*//p' | head -1)
: "${DNS:=1.1.1.1}"

echo "root=$ROOT_DEV ($ROOT_FSTYPE) user=$(whoami) uid=$(id -u)"

# walk ancestor chain to find systemd units that must survive isolate
readarray -t PROTECTED < <(perl -e '
  my %u; my $pid = getppid();
  while ($pid > 1) {
    if (open my $fh, "<", "/proc/$pid/cgroup") {
      while (<$fh>) { $u{$1}++ && last if m{/([^/]+\.(service|scope|slice))\s*$} }
    }
    open my $f, "<", "/proc/$pid/stat" or last;
    $pid = (split " ", <$f>)[3];
  }
  print "$_\n" for sort keys %u;
')
[ ${#PROTECTED[@]} -gt 0 ] || { echo "No ancestor units found — isolate would kill us."; exit 1; }
echo "Protected: ${PROTECTED[*]}"

# build
SYSTEM=$(nix-build "$SCRIPT_DIR/system.nix" \
  --argstr configPath  "$CONFIG_PATH" \
  --argstr nixpkgsSrc  "$NIXPKGS" \
  --argstr rootDevice  "$ROOT_DEV" \
  --argstr rootFsType  "$ROOT_FSTYPE" \
  --argstr nixDevice   "${NIX_DEV:-}" \
  --argstr nixFsType   "${NIX_FSTYPE:-}" \
  --argstr dnsServers  "$DNS" \
  --argstr username    "$(whoami)" \
  --argstr userHome    "$HOME" \
  --argstr userUid     "$(id -u)" \
  --no-out-link)
echo "Built: $SYSTEM ($(nix path-info -rSh "$SYSTEM" 2>/dev/null | tail -1))"

NIX_ENV=$(which nix-env)
LD_PATHS=$(find /etc/ld.so.conf.d -name '*.conf' -exec cat {} + 2>/dev/null | grep -v '^#' | tr '\n' ' ' || true)

# everything below needs root — one sudo bash to avoid exec-after-nix-build issues
sudo bash <<ROOTSHELL
set -euo pipefail

# protect ancestor units and nix-daemon from isolate and NixOS activation
for UNIT in ${PROTECTED[*]} nix-daemon.service; do
  mkdir -p "/etc/systemd/system/\${UNIT}.d"
  printf '[Unit]\nIgnoreOnIsolate=yes\nX-StopOnRemoval=false\nX-StopOnReconfiguration=false\n' \
    > "/etc/systemd/system/\${UNIT}.d/protect.conf"
done
systemctl daemon-reload

# snapshot /etc before we modify it
tar czf /tmp/etc-snapshot.tar.gz -C / etc 2>/dev/null || true

# rescue.service runs sulogin, which blocks waiting for a TTY that doesn't exist on headless systems
mkdir -p /etc/systemd/system/rescue.service.d
printf '[Service]\nExecStart=\nExecStart=/bin/true\n' \
  > /etc/systemd/system/rescue.service.d/no-sulogin.conf
systemctl daemon-reload

echo "Isolating to rescue.target..."
systemctl isolate rescue.target

# preserve protected units in /run so they survive /etc takeover
for UNIT in ${PROTECTED[*]}; do
  [ -f "/etc/systemd/system/\$UNIT" ] && cp "/etc/systemd/system/\$UNIT" "/run/systemd/system/\$UNIT" || true
  [ -d "/etc/systemd/system/\${UNIT}.d" ] && mkdir -p "/run/systemd/system/\${UNIT}.d" && cp -a "/etc/systemd/system/\${UNIT}.d/." "/run/systemd/system/\${UNIT}.d/" || true
done

# clear host paths that conflict with NixOS
mkdir -p /etc.bak
for D in /etc/systemd/system /etc/systemd/user /etc/systemd/system-generators /etc/dbus-1 /etc/fonts /etc/terminfo; do
  [ -d "\$D" ] && [ ! -L "\$D" ] && mv "\$D" "/etc.bak/\$(echo \$D | tr / _)" || true
done
# /lib64 left in place — environment.ldso creates a tmpfiles L+ rule that overwrites the dynamic linker
systemctl daemon-reload

echo "Activating NixOS..."
$NIX_ENV --profile /nix/var/nix/profiles/system --set $SYSTEM
ln -sfn /nix/var/nix/profiles/system /run/current-system
$SYSTEM/activate

# persist host library paths so they survive NixOS ldconfig runs
echo "$LD_PATHS" | tr ' ' '\n' | grep -v '^\$' > /etc/ld.so.conf.d/host-libs.conf 2>/dev/null || true
ldconfig

# clear host systemd artifacts
for D in /usr/lib/systemd/system /usr/lib/systemd/user /usr/lib/systemd/system-generators /usr/lib/systemd/user-generators /usr/lib/tmpfiles.d /lib/systemd/system; do
  [ -d "\$D" ] && mv "\$D" "\${D}.bak" || true
done

# Ubuntu has /lib64 as a symlink — convert to directory so NixOS tmpfiles can manage it
# (use NixOS coreutils which have their own interpreter and don't depend on /lib64)
if [ -L /lib64 ]; then
  TARGET=\$(/run/current-system/sw/bin/readlink -f /lib64)
  /run/current-system/sw/bin/rm /lib64
  /run/current-system/sw/bin/cp -a "\$TARGET" /lib64
fi

# debug: check unit file state before starting services
echo "=== sample unit (nscd) ==="
cat /etc/systemd/system/nscd.service || echo "not found"
echo "=== systemd PID 1 ==="
/run/current-system/sw/bin/readlink -f /proc/1/exe || true
echo "=== host systemd-executor ==="
ls -la /usr/lib/systemd/systemd-executor || echo "not found"
ldd /usr/lib/systemd/systemd-executor || echo "ldd failed"
echo "=== /etc/ld.so.conf ==="
cat /etc/ld.so.conf || true
echo "=== /etc/ld.so.conf.d/ ==="
cat /etc/ld.so.conf.d/*.conf || true
echo "=== /bin/sh ==="
ls -la /bin/sh || echo "/bin/sh missing"
echo "=== try exec nix binary ==="
/run/current-system/sw/bin/true && echo "nix binary works" || echo "nix binary FAILS"
echo "=== try exec host binary ==="
/usr/lib/systemd/systemd-executor --version && echo "host executor works" || echo "host executor FAILS (exit \$?)"
echo "==="

echo "Starting NixOS services..."
/run/current-system/sw/bin/systemctl daemon-reload
/run/current-system/sw/bin/systemd-tmpfiles --create --remove
echo "=== ld.so.conf after tmpfiles ==="
cat /etc/ld.so.conf || true
ls /etc/ld.so.conf.d/ || true
echo "==="
ldconfig $LD_PATHS
/run/current-system/sw/bin/systemctl start multi-user.target
/run/current-system/sw/bin/systemctl is-system-running --wait || true

STATUS=\$(/run/current-system/sw/bin/systemctl is-system-running || true)
echo "System: \$STATUS"
/run/current-system/sw/bin/systemd-analyze blame --no-pager || true
/run/current-system/sw/bin/systemd-analyze critical-chain --no-pager || true
if [ "\$STATUS" != "running" ]; then
  /run/current-system/sw/bin/systemctl --failed --no-pager
  /run/current-system/sw/bin/systemctl --failed --plain --no-legend --no-pager | while read -r UNIT _REST; do
    echo "=== \$UNIT ==="
    /run/current-system/sw/bin/journalctl -u "\$UNIT" --no-pager --lines=15 || true
  done
  exit 1
fi
sudo -n true || exit 1
ROOTSHELL

if [ -n "${GITHUB_PATH:-}" ]; then
  echo "/run/wrappers/bin" >> "$GITHUB_PATH"
  echo "/run/current-system/sw/bin" >> "$GITHUB_PATH"
fi
