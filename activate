#!/usr/bin/env nix-shell
#! nix-shell -i bash -p perl
set -euo pipefail

CONFIG_PATH="$(realpath "$1")"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

NIXPKGS="${2:-}"
if [ -z "$NIXPKGS" ] && [ -f "$SCRIPT_DIR/flake.lock" ]; then
  NIXPKGS=$(nix-instantiate --eval -E \
    "(builtins.fromJSON (builtins.readFile $SCRIPT_DIR/flake.lock)).nodes.nixpkgs.locked.rev" \
    | tr -d '"')
fi
: "${NIXPKGS:=nixos-unstable}"

# preflight
[ "$(uname -s)" = "Linux" ]    || { echo "Requires Linux."; exit 1; }
[ -d /run/systemd/system ]     || { echo "Requires systemd."; exit 1; }
[ ! -f /etc/NIXOS ]            || { echo "Already NixOS."; exit 1; }
command -v nix-build >/dev/null || { echo "Requires Nix."; exit 1; }
sudo -n true 2>/dev/null        || { echo "Requires passwordless sudo."; exit 1; }

if [ -z "${CI:-}" ]; then
  read -rp "This will soft-reboot into NixOS. Are you sure? [y/N] " confirm
  [[ "$confirm" == [yY] ]] || exit 1
fi

ROOT_DEV=$(findmnt -n -o SOURCE /)
ROOT_FSTYPE=$(findmnt -n -o FSTYPE /)
NIX_DEV=$(findmnt -n -o SOURCE /nix 2>/dev/null || true)
NIX_FSTYPE=$(findmnt -n -o FSTYPE /nix 2>/dev/null || true)
DNS=$(resolvectl status 2>/dev/null | sed -n 's/.*DNS Servers:[[:space:]]*//p' | head -1)
: "${DNS:=1.1.1.1}"

echo "root=$ROOT_DEV ($ROOT_FSTYPE) user=$(whoami) uid=$(id -u)"

# walk ancestor chain to find systemd units that must survive soft-reboot
readarray -t PROTECTED < <(perl -e '
  my %u; my $pid = getppid();
  while ($pid > 1) {
    if (open my $fh, "<", "/proc/$pid/cgroup") {
      while (<$fh>) { $u{$1}++ && last if m{/([^/]+\.(service|scope|slice))\s*$} }
    }
    open my $f, "<", "/proc/$pid/stat" or last;
    $pid = (split " ", <$f>)[3];
  }
  print "$_\n" for sort keys %u;
')
[ ${#PROTECTED[@]} -gt 0 ] || { echo "No ancestor units found."; exit 1; }
echo "Protected: ${PROTECTED[*]}"

# build
SYSTEM=$(nix-build "$SCRIPT_DIR/system.nix" \
  --argstr configPath  "$CONFIG_PATH" \
  --argstr nixpkgsSrc  "$NIXPKGS" \
  --argstr rootDevice  "$ROOT_DEV" \
  --argstr rootFsType  "$ROOT_FSTYPE" \
  --argstr nixDevice   "${NIX_DEV:-}" \
  --argstr nixFsType   "${NIX_FSTYPE:-}" \
  --argstr dnsServers  "$DNS" \
  --argstr username    "$(whoami)" \
  --argstr userHome    "$HOME" \
  --argstr userUid     "$(id -u)" \
  --no-out-link)
echo "Built: $SYSTEM"

if [ -n "${GITHUB_PATH:-}" ]; then
  echo "/run/wrappers/bin" >> "$GITHUB_PATH"
  echo "$SYSTEM/sw/bin" >> "$GITHUB_PATH"
fi

NIX_ENV=$(which nix-env)
NIXOS_SYSTEMD="$SYSTEM/systemd"

# --- construct new root on disk ---
TIMESTAMP=$(date +%Y%m%d-%H%M%S)
NEW_ROOT="/nixos-roots/$TIMESTAMP"

sudo bash <<ROOTSHELL
set -euo pipefail

mkdir -p $NEW_ROOT

# base directory structure
for d in etc var var/lib var/log tmp root \
         usr/lib/systemd bin sbin nix \
         run dev proc sys home; do
  mkdir -p "$NEW_ROOT/\$d"
done

# bind-mount /nix so the store is available in new root
mount --bind /nix "$NEW_ROOT/nix"

# /home: pass through so agent and user data survive
mount --bind /home "$NEW_ROOT/home"

# mount kernel filesystems for chroot activation
mount --bind /dev "$NEW_ROOT/dev"
mount --bind /proc "$NEW_ROOT/proc"
mount --bind /sys "$NEW_ROOT/sys"
mount --bind /run "$NEW_ROOT/run"

# PID 1 re-execs from /usr/lib/systemd/systemd after pivot_root
ln -sf "$NIXOS_SYSTEMD/lib/systemd/systemd" "$NEW_ROOT/usr/lib/systemd/systemd"
ln -sf "$NIXOS_SYSTEMD/lib/systemd/systemd-executor" "$NEW_ROOT/usr/lib/systemd/systemd-executor"
ln -sf "$NIXOS_SYSTEMD/lib/systemd/systemd" "$NEW_ROOT/sbin/init"

# set up NixOS system profile and activate inside new root
$NIX_ENV --profile /nix/var/nix/profiles/system --set $SYSTEM
ln -sfn /nix/var/nix/profiles/system "$NEW_ROOT/run/current-system"

# activate NixOS — populates /etc, creates users, sets up unit symlinks
NIXOS_ACTION=switch NIXOS_INSTALL_BOOTLOADER=0 \
  chroot "$NEW_ROOT" /nix/var/nix/profiles/system/activate 2>&1 || true

# unmount kernel filesystems from chroot (systemd will re-mount after pivot)
umount "$NEW_ROOT/run"
umount "$NEW_ROOT/sys"
umount "$NEW_ROOT/proc"
umount "$NEW_ROOT/dev"

# protect ancestor units: survive the soft-reboot kill phase
for UNIT in ${PROTECTED[*]} nix-daemon.service; do
  mkdir -p "/run/systemd/system/\${UNIT}.d"
  printf '[Unit]\nIgnoreOnIsolate=yes\nSurviveFinalKillSignal=yes\n' \
    > "/run/systemd/system/\${UNIT}.d/survive.conf"
done
systemctl daemon-reload

# make new root a mount point (pivot_root requires this)
mount --bind "$NEW_ROOT" "$NEW_ROOT"

# point systemd at the new root and trigger soft-reboot
ln -sfn "$NEW_ROOT" /run/nextroot
echo "New root ready at $NEW_ROOT — triggering soft-reboot..."
systemctl soft-reboot
ROOTSHELL
